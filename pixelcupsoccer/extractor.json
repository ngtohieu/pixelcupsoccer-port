{
  "schema": 1,
  "id": "pixelcupsoccer-nextos",
  "version": "1.0",
  "title": "PIXEL CUP SOCCER",
  "abi_order": [
    "arm64-v8a"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "packages": [
      "com.BatoviGamesStudio.PixelCupSoccer19"
    ],
    "max_files": 128,
    "max_bundle_apks": 64,
    "max_member_bytes": 3221225472,
    "max_bundle_bytes": 6442450944
  },
  "extract": [
    {
      "id": "android-native-libs",
      "source": {
        "kind": "entries",
        "patterns": [
          "lib/{abi}/libmain.so",
          "lib/{abi}/libunity.so",
          "lib/{abi}/libil2cpp.so"
        ],
        "strip_prefix": "lib/{abi}/"
      },
      "destination": "lib",
      "validate": {
        "type": "tree",
        "min_files": 3,
        "max_files": 64,
        "required_paths": [
          "libmain.so",
          "libunity.so",
          "libil2cpp.so"
        ]
      }
    },
    {
      "id": "unity-data-apk",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/bin/Data/**"
        ],
        "strip_prefix": "assets/bin/Data/"
      },
      "destination": "assets/bin/Data",
      "validate": {
        "type": "tree",
        "min_files": 5,
        "max_files": 3000,
        "required_paths": [
          "boot.config",
          "data.unity3d",
          "Managed/Metadata/global-metadata.dat"
        ]
      }
    }
  ],
  "hooks": [
    {
      "id": "merge-datapack",
      "argv": [
        "python3",
        "{game_dir}/nxextract/merge-datapack.py",
        "{stage}"
      ],
      "cwd": "{stage}",
      "checkpoint": [
        {
          "path": "assets/bin/Data/data.unity3d",
          "type": "file",
          "min_size": 400000000
        }
      ]
    }
  ],
  "validate": [
    {
      "path": "assets/bin/Data",
      "type": "tree",
      "min_files": 5,
      "required_paths": [
        "boot.config",
        "data.unity3d",
        "Managed/Metadata/global-metadata.dat"
      ]
    },
    {
      "path": "assets/bin/Data/data.unity3d",
      "type": "file",
      "min_size": 400000000
    },
    {
      "path": "lib/libmain.so",
      "type": "file",
      "elf_machine": "arm64-v8a"
    },
    {
      "path": "lib/libunity.so",
      "type": "file",
      "elf_machine": "arm64-v8a"
    },
    {
      "path": "lib/libil2cpp.so",
      "type": "file",
      "elf_machine": "arm64-v8a"
    }
  ],
  "commit": [
    "assets",
    "lib"
  ],
  "marker": ".nxextract-pixelcupsoccer.json",
  "space": {
    "safety_bytes": 1073741824
  },
  "log": "nxextract.log",
  "ui_success_seconds": 1,
  "ui_error_seconds": 8
}
